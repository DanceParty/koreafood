---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ink?: { paper: string; ink: string; accent: string };
  /** File name under /og, without extension. */
  og?: string;
}

const { title, description, ink, og = "home" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${og}.png`, Astro.site);
const vars = ink ? `--paper:${ink.paper};--ink:${ink.ink};--accent:${ink.accent}` : undefined;
---
<!doctype html>
<html lang="en" style={vars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="이맘때 imamttae" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={ink?.paper ?? "#f5d94e"} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/black-han-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/do-hyeon.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/"><span lang="ko">이맘때</span><span class="brand-rr">imamttae</span></a>
      <nav aria-label="Main">
        <a href="/">Today</a>
        <a href="/months/">Months</a>
        <a href="/almanac/">Almanac</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <slot />
    <footer class="foot">
      <p><span lang="ko">이맘때</span> means "around this time of year." A calendar of what Korea eats, and when.</p>
      <p>Made by <a href="https://www.keevandance.com">Keevan Dance</a>. Dates come from researched sources, listed on every food.</p>
    </footer>
  </body>
</html>
