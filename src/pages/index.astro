---
import Base from "../layouts/Base.astro";
import { Home } from "../components/Home.tsx";
import { todayInSeoul } from "../lib/dates.ts";
import { printedOn } from "../lib/palette.ts";

const builtOn = todayInSeoul();
const { vars } = printedOn(builtOn);
---
<Base title="이맘때 imamttae: what to eat in Korea right now" description="Spin a year of Korean seasonal food. Find what is good to eat in Korea today, or any other day of the year." ink={vars}>
  <Home client:load builtOn={builtOn} />
</Base>
