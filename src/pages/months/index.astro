---
import Base from "../../layouts/Base.astro";
import { toParts, todayInSeoul } from "../../lib/dates.ts";
import { midMonth, monthFoods, yearForMonth } from "../../lib/foods.ts";
import { MONTH_COPY } from "../../lib/months.ts";
import { printedOn } from "../../lib/palette.ts";

const today = todayInSeoul();
const current = toParts(today).month;
const months = MONTH_COPY.map((copy, index) => {
  const month = index + 1;
  const year = yearForMonth(month);
  const printed = printedOn(midMonth(month, year));
  const foods = monthFoods(month, year);
  return { ...copy, month, printed, top: foods.filter((entry) => entry.food.tier === "national").slice(0, 5), count: foods.length };
});
---
<Base title="Korea's food year, month by month" description="Twelve months of Korean seasonal food, from yellowtail in January to red-bean porridge in December." ink={printedOn(today).vars}>
  <main class="months">
    <h1><span lang="ko">열두 달</span> Twelve months</h1>
    <ol class="month-grid">
      {months.map((entry) => (
        <li>
          <a class:list={["month-tile", { now: entry.month === current }]} href={`/months/${entry.slug}/`} style={`--paper:${entry.printed.vars.paper};--ink:${entry.printed.vars.ink};--accent:${entry.printed.vars.accent}`}>
            <span class="tile-num">{entry.month}</span>
            <span class="tile-name">{entry.name}{entry.month === current ? ", now" : ""}</span>
            <span class="tile-title">{entry.title}</span>
            <span class="tile-foods" lang="ko">{entry.top.map((food) => food.food.ko).join(" ")}</span>
            <span class="tile-count">{entry.count} foods</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>
